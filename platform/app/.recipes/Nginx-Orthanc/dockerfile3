# syntax=docker/dockerfile:1
# Stage 1: Build the application
FROM node:20.18.1-slim as builder

# Setup the working directory
WORKDIR /usr/src/app

# Copy package.json and yarn.lock first for better layer caching
COPY package.json yarn.lock ./
COPY platform/app/package.json ./platform/app/
COPY extensions/*/package.json ./extensions/*/
COPY modes/*/package.json ./modes/*/
COPY packages/*/package.json ./packages/*/
COPY platform/core/package.json ./platform/core/
COPY platform/docs/package.json ./platform/docs/
COPY platform/i18n/package.json ./platform/i18n/
COPY platform/ui/package.json ./platform/ui/

# Install dependencies with cache mount
RUN --mount=type=cache,target=/root/.yarn \
    yarn config set workspaces-experimental true && \
    yarn install --frozen-lockfile --cache-folder /root/.yarn --network-timeout 300000

# Copy all source code
COPY ./ ./

# Set environment variables
ENV APP_CONFIG=config/docker-nginx-orthanc.js
ENV NODE_ENV=production

# Support QUICK_BUILD from docker-compose
ARG QUICK_BUILD=false
ENV QUICK_BUILD=${QUICK_BUILD}

# Build the application
RUN if [ "$QUICK_BUILD" = "true" ]; then \
        echo "Quick build enabled" && \
        NODE_ENV=development yarn run build:dev 2>/dev/null || yarn run build; \
    else \
        echo "Full production build" && \
        yarn run build; \
    fi

# Stage 2: Production nginx server
FROM nginx:alpine

# Create directories and set permissions
RUN mkdir -p /var/log/nginx /var/www/html && \
    chown -R nginx:nginx /var/www/html /var/log/nginx

# Copy build output to the correct nginx directory
COPY --from=builder /usr/src/app/platform/app/dist /var/www/html

# Create a default nginx config if one isn't mounted
RUN echo 'server { \
    listen 80; \
    listen 443 ssl; \
    server_name localhost; \
    \
    root /var/www/html; \
    index index.html; \
    \
    # Gzip compression \
    gzip on; \
    gzip_types text/plain application/json application/javascript text/css application/xml text/xml; \
    \
    # Handle client-side routing \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    \
    # API proxy to Orthanc \
    location /pacs/ { \
        proxy_pass http://orthanc:8042/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_request_buffering off; \
        proxy_max_temp_file_size 0; \
        client_max_body_size 0; \
    } \
    \
    location /wado { \
        proxy_pass http://orthanc:8042/wado; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Expose ports
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]